{
  "name": "tree-sitter-witze",
  "version": "0.0.3",
  "description": "Tree-sitter grammar for Witze, a language similar to the scripting language used by the Clausewitz game engine",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acovaci/tree-sitter-witze.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "Adrian Covaci",
    "email": "6562353+acovaci@users.noreply.github.com",
    "url": "https://adriancovaci.dev"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "witze"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "metadata": {
    "version": "0.0.3"
  }
}
