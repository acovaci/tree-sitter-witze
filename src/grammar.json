{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "witze",
  "rules": {
    "source_file": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "content_file"
        },
        {
          "type": "SYMBOL",
          "name": "localisation_file"
        }
      ]
    },
    "content_file": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "definition"
      }
    },
    "localisation_file": {
      "type": "SYMBOL",
      "name": "language_localisation"
    },
    "collection": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "literal"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "predicate": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "definition"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "definition": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_primitive_definition"
        },
        {
          "type": "SYMBOL",
          "name": "_composite_definition"
        },
        {
          "type": "SYMBOL",
          "name": "_id_definition"
        }
      ]
    },
    "_primitive_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_value"
          }
        }
      ]
    },
    "_id_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "STRING",
            "value": "id"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "id"
          }
        }
      ]
    },
    "_composite_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "operand",
          "content": {
            "type": "SYMBOL",
            "name": "logical_operator"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "SYMBOL",
          "name": "predicate"
        }
      ]
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "literal"
        },
        {
          "type": "SYMBOL",
          "name": "predicate"
        },
        {
          "type": "SYMBOL",
          "name": "collection"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "member"
        }
      ]
    },
    "member": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "parent",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "FIELD",
          "name": "member",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "identifier"
              },
              {
                "type": "SYMBOL",
                "name": "member"
              }
            ]
          }
        }
      ]
    },
    "id": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "namespace",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "FIELD",
          "name": "id_number",
          "content": {
            "type": "SYMBOL",
            "name": "id_number"
          }
        }
      ]
    },
    "id_number": {
      "type": "SYMBOL",
      "name": "_positive_integer"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_]+"
    },
    "logical_operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "NOT"
        },
        {
          "type": "STRING",
          "value": "NOR"
        },
        {
          "type": "STRING",
          "value": "OR"
        }
      ]
    },
    "literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "boolean"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"]*\""
    },
    "number": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "integer"
        },
        {
          "type": "SYMBOL",
          "name": "decimal"
        }
      ]
    },
    "integer": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_positive_integer"
        },
        {
          "type": "SYMBOL",
          "name": "_negative_integer"
        }
      ]
    },
    "_positive_integer": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "_negative_integer": {
      "type": "PATTERN",
      "value": "-\\d+"
    },
    "decimal": {
      "type": "PATTERN",
      "value": "-?\\d+\\.\\d+"
    },
    "boolean": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "yes"
        },
        {
          "type": "STRING",
          "value": "no"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "language_localisation": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "language_identifier"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "_localisation_definitions"
        }
      ]
    },
    "language_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "l_[a-z_]+"
        }
      }
    },
    "_localisation_definitions": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "localisation_definition"
      }
    },
    "localisation_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "localisation_key",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_positive_integer"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "localisation_string",
          "content": {
            "type": "SYMBOL",
            "name": "localisation_string"
          }
        }
      ]
    },
    "localisation_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_localisation_string_content"
              },
              {
                "type": "SYMBOL",
                "name": "interpolation"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "_localisation_string_content": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^$\"]+"
        }
      }
    },
    "interpolation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "STRING",
          "value": "$"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [
    [
      "predicate",
      "collection"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [
    "literal",
    "number"
  ],
  "reserved": {}
}
